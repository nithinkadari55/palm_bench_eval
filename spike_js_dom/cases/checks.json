    "03_echarts_svg": {
      "title": "ECharts SSR SVG string (phase 5 bundle in the same runtime) inserted with innerHTML",
      "assets": ["shims.js", "echarts.js", "echarts_option.js", "echarts_fallback.js"],
      "checks": [
        { "type": "regex", "value": "chart source:\\s*(bundle|fallback)" },
        { "type": "regex", "value": "chart source:\\s*bundle", "required": false, "desc": "SVG generated by the phase 5 bundle inside this runtime (fallback = pre-generated SVG)" },
        { "type": "regex", "value": "svg paths\\s*=\\s*[1-9]" },
        { "type": "color_count", "rgb": [214, 39, 40], "tol": 40, "min": 3000, "desc": "series bars (#d62728) painted" },
        { "type": "text", "value": "Revenue by quarter", "required": false, "desc": "SVG <text> extractable from the PDF" }
      ]
    },
    "04_layout_query": {
      "title": "Layout query: width set via style, getBoundingClientRect().width written into text",
      "checks": [
        { "type": "width_text", "regex": "W1=\\s*([0-9.]+)", "id": "box", "expect": 337, "tol": 1, "raster_rgb": [[46, 125, 50], [0, 0, 0]] },
        { "type": "width_text", "regex": "OW1=\\s*([0-9.]+)", "id": "box", "expect": 337, "tol": 1 },
        { "type": "width_text", "regex": "W2=\\s*([0-9.]+)", "id": "box2", "tol": 1, "raster_rgb": [[106, 27, 154]] },
        { "type": "width_text", "regex": "W3=\\s*([0-9.]+)", "id": "f1", "expect": 200, "tol": 1, "raster_rgb": [[239, 108, 0]] },
        { "type": "metric", "key": "relayout_count", "op": ">=", "value": 2, "required": false, "desc": "dirty-flag relayouts (3 expected: one per mutate-then-measure step)" }
      ]
    },
    "05_script_error": {
      "title": "Script errors do not kill the render and appear in diagnostics",
      "checks": [
        { "type": "text", "value": "First script ran" },
        { "type": "text", "value": "Third script ran" },
        { "type": "text", "value": "Timer after error ran" },
        { "type": "text", "value": "Listener ran" },
        { "type": "absent", "value": "NEVER" },
        { "type": "diag", "kind": "js:uncaught", "contains": "(TypeError|null|undefined)", "desc": "property access on null reported" },
        { "type": "diag", "kind": "js:uncaught", "contains": "SyntaxError", "desc": "syntax error reported" },
        { "type": "diag", "kind": "js:uncaught", "contains": "timer kaboom", "desc": "error thrown in a timer reported" },
        { "type": "diag", "kind": "js:console.error", "contains": "custom diagnostic 42", "desc": "console.error routed to diagnostics" }
      ]
    }
